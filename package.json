{
  "name": "@farfarfun/utools-fundata",
  "funbuild": { "build": "sh build.sh" },
  "version": "0.1.0",
  "description": "数形万变 FunData：离线 11 合 1 开发者数据工具箱，支持 10 格式互转、文本编解码、Unix 时间戳、JWT 验签签发、Protobuf、SQL、哈希/UUID、正则、Cron、色值进制与文本对比",
  "license": "MIT",
  "homepage": "https://farfarfun.github.io/packages/utools-fundata/",
  "repository": {
    "type": "git",
    "url": "https://github.com/farfarfun-utools/utools-fundata.git"
  },
  "bugs": {
    "url": "https://github.com/farfarfun-utools/utools-fundata/issues"
  },
  "keywords": [
    "utools",
    "utools-plugin",
    "fundata",
    "yaml",
    "toml",
    "xml",
    "csv",
    "sql",
    "jwt",
    "protobuf",
    "regex",
    "cron",
    "hash",
    "uuid",
    "diff",
    "vue3",
    "typescript",
    "farfarfun"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "screenshots": "pnpm build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "js-yaml": "^4.1.0",
    "json5": "^2.2.3",
    "smol-toml": "^1.3.4",
    "sql-formatter": "^15.6.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/diff": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.12"
  }
}
