{
  "name": "@farfarfun/utools-funjson",
  "funbuild": { "build": "sh build.sh" },
  "version": "0.1.0",
  "description": "数形万变 FunJSON：离线 JSON 与多格式数据处理工作台，支持文本/树形/栏列/表格/差异对比、JSONPath 查询、智能解码与 8 合 1 工具箱",
  "license": "MIT",
  "homepage": "https://farfarfun.github.io/packages/utools-funjson/",
  "repository": {
    "type": "git",
    "url": "https://github.com/farfarfun-utools/utools-funjson.git"
  },
  "bugs": {
    "url": "https://github.com/farfarfun-utools/utools-funjson/issues"
  },
  "keywords": [
    "utools",
    "utools-plugin",
    "json",
    "json5",
    "yaml",
    "toml",
    "xml",
    "jsonpath",
    "jwt",
    "protobuf",
    "diff",
    "vue3",
    "typescript",
    "farfarfun"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "screenshots": "pnpm build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
