{
  "pluginName": "数形万变",
  "version": "0.1.0",
  "description": "数形万变 FunData：离线 10 合 1 开发者数据工具箱，支持 10 格式互转、编解码与时间戳、JWT 验签签发、Protobuf、SQL、哈希/UUID、正则、Cron、色值进制与文本对比",
  "author": "farfarfun",
  "main": "dist/index.html",
  "preload": "preload.js",
  "logo": "logo.png",
  "pluginSetting": {
    "height": 720
  },
  "platform": [
    "darwin",
    "win32",
    "linux"
  ],
  "features": [
    {
      "code": "fundata",
      "explain": "打开数形万变 10 合 1 开发者数据工具箱",
      "cmds": [
        "数形万变",
        "FunData",
        "数据转换",
        "yaml",
        "toml"
      ]
    },
    {
      "code": "fundata-convert",
      "explain": "10 格式万能互转（JSON / YAML / TOML / XML / CSV / INI）",
      "cmds": [
        "格式转换",
        "xml",
        "csv",
        "ini"
      ]
    },
    {
      "code": "fundata-sql",
      "explain": "SQL 多方言格式化与 Protobuf 安全重编号",
      "cmds": [
        "sql",
        "SQL格式化",
        "protobuf"
      ]
    },
    {
      "code": "fundata-encode",
      "explain": "编解码、多时区时间戳与 JWT 验签签发",
      "cmds": [
        "base64",
        "编解码",
        "时间戳",
        "jwt"
      ]
    },
    {
      "code": "fundata-crypto",
      "explain": "哈希 / HMAC 计算与 UUID / 密钥批量生成",
      "cmds": [
        "hash",
        "md5",
        "sha256",
        "uuid"
      ]
    },
    {
      "code": "fundata-regex",
      "explain": "正则表达式实验室、Cron 表达式解析与文本对比",
      "cmds": [
        "regex",
        "正则",
        "cron",
        "文本对比"
      ]
    },
    {
      "code": "data-files",
      "explain": "用数形万变打开并转换数据、SQL 或 Protobuf 文件",
      "cmds": [
        {
          "type": "files",
          "label": "用数形万变打开",
          "fileType": "file",
          "match": "/\\.(yaml|yml|toml|xml|csv|tsv|ini|ndjson|jsonl|proto|sql|txt)$/i",
          "minLength": 1,
          "maxLength": 10
        }
      ]
    },
    {
      "code": "data-over",
      "explain": "将选中文本智能路由至数形万变对应工具处理",
      "cmds": [
        {
          "type": "over",
          "label": "用数形万变处理",
          "minLength": 2,
          "maxLength": 200000
        }
      ]
    }
  ],
  "tools": {
    "convert_data_format": {
      "description": "离线在 JSON / JSON5 / YAML / TOML / XML / CSV / TSV / INI / NDJSON / Query 之间转换数据格式。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "type": "string",
            "description": "源数据文本"
          },
          "from": {
            "type": "string",
            "enum": [
              "auto",
              "json",
              "json5",
              "yaml",
              "toml",
              "xml",
              "csv",
              "tsv",
              "ini",
              "ndjson",
              "query"
            ],
            "description": "源格式，默认 auto 自动识别"
          },
          "to": {
            "type": "string",
            "enum": [
              "json",
              "json5",
              "yaml",
              "toml",
              "xml",
              "csv",
              "tsv",
              "ini",
              "ndjson",
              "query"
            ],
            "description": "目标格式"
          }
        },
        "required": [
          "input",
          "to"
        ]
      }
    },
    "decode_jwt": {
      "description": "离线解析 JWT 的 Header 与 Payload 并检查 exp/nbf 时间状态；不联网也不保存令牌。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT 字符串（header.payload.signature）"
          }
        },
        "required": [
          "token"
        ]
      }
    },
    "format_sql": {
      "description": "离线格式化或压缩 SQL 语句，支持 Standard SQL / MySQL / PostgreSQL / SQLite / BigQuery / T-SQL 方言。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "type": "string",
            "description": "待处理的 SQL 文本"
          },
          "dialect": {
            "type": "string",
            "enum": [
              "sql",
              "mysql",
              "postgresql",
              "sqlite",
              "bigquery",
              "tsql"
            ],
            "description": "SQL 方言（默认 sql）"
          },
          "keywordCase": {
            "type": "string",
            "enum": [
              "upper",
              "lower",
              "preserve"
            ],
            "description": "关键字大小写风格（默认 upper）"
          },
          "mode": {
            "type": "string",
            "enum": [
              "format",
              "minify"
            ],
            "description": "format 美化（默认）或 minify 压缩为单行"
          },
          "indent": {
            "type": "number",
            "description": "缩进空格数（2 或 4，默认 2）"
          }
        },
        "required": [
          "input"
        ]
      }
    },
    "parse_cron": {
      "description": "离线解析 5 位或 6 位（含秒）Cron 表达式，返回中英文自然语言说明与未来 N 次精确触发时间。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expression": {
            "type": "string",
            "description": "Cron 表达式（5 位或 6 位），如 */5 * * * * 或 0 9 * * 1-5"
          },
          "count": {
            "type": "number",
            "description": "计算未来触发次数（1-20，默认 10）"
          },
          "timeZone": {
            "type": "string",
            "description": "IANA 时区名称，默认 Asia/Shanghai"
          }
        },
        "required": [
          "expression"
        ]
      }
    },
    "compute_hash": {
      "description": "离线计算文本的 MD5 / SHA-1 / SHA-256 / SHA-384 / SHA-512 哈希摘要或 HMAC 签名；不保存或上传数据。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "type": "string",
            "description": "待计算哈希的输入文本"
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "md5",
              "sha1",
              "sha256",
              "sha384",
              "sha512"
            ],
            "description": "哈希算法（默认 sha256）"
          },
          "hmacKey": {
            "type": "string",
            "description": "可选 HMAC 密钥，传入后计算对应算法的 HMAC"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "hex",
              "HEX",
              "base64"
            ],
            "description": "输出编码（默认 hex）"
          }
        },
        "required": [
          "input"
        ]
      }
    }
  }
}
