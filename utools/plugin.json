{
  "pluginName": "数形万变",
  "version": "0.1.0",
  "description": "数形万变 FunData：离线 JSON 与多格式数据处理工作台，支持文本/树形/栏列/表格/差异对比、JSONPath 查询、智能解码与 8 合 1 工具箱",
  "author": "farfarfun",
  "main": "dist/index.html",
  "preload": "preload.js",
  "logo": "logo.png",
  "pluginSetting": {
    "height": 720
  },
  "platform": [
    "darwin",
    "win32",
    "linux"
  ],
  "features": [
    {
      "code": "fundata",
      "explain": "打开 JSON 与多格式数据处理工作台",
      "cmds": [
        "数形万变",
        "FunData",
        "fundata",
        "json",
        "JSON",
        "JSON格式化",
        "数据转换",
        "yaml",
        "toml",
        "xml",
        "jwt",
        "protobuf"
      ]
    },
    {
      "code": "json-regex",
      "explain": "识别并格式化剪贴板或输入的 JSON 数据",
      "cmds": [
        {
          "type": "regex",
          "label": "JSON 格式化",
          "match": "/^\\s*(\\{[\\s\\S]*\\}|\\[[\\s\\S]*\\])\\s*$/",
          "minLength": 2
        }
      ]
    },
    {
      "code": "json-files",
      "explain": "用数形万变打开并编辑数据文件",
      "cmds": [
        {
          "type": "files",
          "label": "用数形万变打开",
          "fileType": "file",
          "match": "/\\.(json|json5|jsonc|yaml|yml|toml|xml|csv|tsv|ini|ndjson|jsonl|proto|sql)$/i",
          "minLength": 1,
          "maxLength": 10
        }
      ]
    },
    {
      "code": "json-over",
      "explain": "将选中文本载入数形万变解析、格式化或转换",
      "cmds": [
        {
          "type": "over",
          "label": "用数形万变解析",
          "minLength": 2,
          "maxLength": 200000
        }
      ]
    }
  ],
  "tools": {
    "format_json": {
      "description": "离线校验、格式化、压缩、按键排序或自动修复 JSON / JSON5 文本；不保存或上传数据。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "type": "string",
            "description": "待处理的 JSON 或 JSON5 文本"
          },
          "mode": {
            "type": "string",
            "enum": [
              "format",
              "minify"
            ],
            "description": "format 美化（默认）或 minify 压缩"
          },
          "indent": {
            "type": "number",
            "description": "缩进空格数（1-8，默认 2）"
          },
          "repair": {
            "type": "boolean",
            "description": "语法有误时是否尝试自动修复（默认 true）"
          },
          "sortKeys": {
            "type": "string",
            "enum": [
              "none",
              "asc",
              "desc"
            ],
            "description": "是否递归排序对象键（默认 none）"
          }
        },
        "required": [
          "input"
        ]
      }
    },
    "query_jsonpath": {
      "description": "使用 RFC 9535 JSONPath 表达式离线查询 JSON / JSON5 数据，返回匹配数组及数量。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "type": "string",
            "description": "JSON 或 JSON5 文本"
          },
          "expression": {
            "type": "string",
            "description": "JSONPath 表达式，如 $.users[*].name"
          }
        },
        "required": [
          "input",
          "expression"
        ]
      }
    },
    "convert_data_format": {
      "description": "离线在 JSON / JSON5 / YAML / TOML / XML / CSV / TSV / INI / NDJSON / Query 之间转换数据格式。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "type": "string",
            "description": "源数据文本"
          },
          "from": {
            "type": "string",
            "enum": [
              "auto",
              "json",
              "json5",
              "yaml",
              "toml",
              "xml",
              "csv",
              "tsv",
              "ini",
              "ndjson",
              "query"
            ],
            "description": "源格式，默认 auto 自动识别"
          },
          "to": {
            "type": "string",
            "enum": [
              "json",
              "json5",
              "yaml",
              "toml",
              "xml",
              "csv",
              "tsv",
              "ini",
              "ndjson",
              "query"
            ],
            "description": "目标格式"
          }
        },
        "required": [
          "input",
          "to"
        ]
      }
    },
    "json_to_types": {
      "description": "根据 JSON 样本离线生成 TypeScript / Go / Java / Rust / Python / Kotlin / Swift / C# / JSON Schema 类型定义。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "type": "string",
            "description": "JSON 样本"
          },
          "language": {
            "type": "string",
            "enum": [
              "typescript",
              "go",
              "java",
              "rust",
              "python",
              "kotlin",
              "swift",
              "csharp",
              "jsonschema"
            ],
            "description": "目标语言"
          },
          "rootName": {
            "type": "string",
            "description": "根类型名称，默认 Root"
          }
        },
        "required": [
          "input",
          "language"
        ]
      }
    },
    "decode_jwt": {
      "description": "离线解析 JWT 的 Header 与 Payload 并检查 exp/nbf 时间状态；不联网也不保存令牌。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT 字符串（header.payload.signature）"
          }
        },
        "required": [
          "token"
        ]
      }
    }
  }
}
